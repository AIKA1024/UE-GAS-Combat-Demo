# ============================================
# Git Attributes
# ============================================

# ============================================
# Unreal 资产 —— 二进制，不做行尾转换与 diff
# ============================================
*.uasset  binary
*.umap    binary
*.uexp    binary
*.ubulk   binary
*.uptnl   binary

# ============================================
# 图片 / 媒体 —— 二进制
# ============================================
*.png   binary
*.jpg   binary
*.jpeg  binary
*.bmp   binary
*.tga   binary
*.dds   binary
*.exr   binary
*.psd   binary
*.wav   binary
*.mp3   binary
*.ogg   binary
*.mp4   binary
*.mov   binary
*.webm  binary

# ============================================
# Source Code — Text (auto line endings)
# ============================================
*.h      text eol=crlf
*.cpp    text eol=crlf
*.c      text eol=crlf
*.hpp    text eol=crlf
*.cxx    text eol=crlf
*.hxx    text eol=crlf
*.cs     text eol=crlf
*.inl    text eol=crlf
*.tpp    text eol=crlf

# ============================================
# Project / Build Configuration — Text
# ============================================
*.uproject  text eol=crlf
*.uplugin   text eol=crlf
*.Build.cs  text eol=crlf
*.Target.cs text eol=crlf
*.ini       text eol=crlf
*.cfg       text eol=crlf
*.xml       text eol=crlf
*.json      text eol=crlf
*.txt       text eol=crlf
*.md        text eol=crlf
*.bat       text eol=crlf
*.sh        text eol=lf
*.command   text eol=lf

# ============================================
# Shader Source — Text
# ============================================
*.usf     text eol=crlf
*.ush     text eol=crlf
*.hlsl    text eol=crlf
*.glsl    text eol=lf
